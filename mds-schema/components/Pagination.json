{
  "component": "Pagination",
  "category": "Pagination",
  "description": "MDS Pagination component",
  "platform": [
    "web",
    "app"
  ],
  "props": {
    "totalPages": {
      "type": "number",
      "required": true,
      "description": "전체 페이지 수"
    },
    "currentPage": {
      "type": "number",
      "required": true,
      "description": "현재 활성 페이지 (1부터 시작)"
    },
    "variant": {
      "type": "enum",
      "required": false,
      "description": "스타일",
      "values": [
        "solid",
        "ghost"
      ],
      "default": "solid"
    }
  }
}
