{
  "component": "ButtonBasic",
  "category": "Buttons",
  "description": "MDS ButtonBasic component",
  "platform": [
    "web",
    "app"
  ],
  "props": {
    "variant": {
      "type": "enum",
      "required": false,
      "description": "강조 수준 스타일 (plain · outlined · tonal · solid)",
      "values": [
        "plain",
        "outlined",
        "tonal",
        "solid"
      ],
      "default": "solid"
    },
    "size": {
      "type": "enum",
      "required": false,
      "description": "높이 기준 사이즈 (xs=28 · sm=36 · md=40 · lg=44 · xl=48 · 2xl=52)",
      "values": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl",
        "2xl"
      ],
      "default": "md"
    },
    "color": {
      "type": "enum",
      "required": false,
      "description": "색상 테마",
      "values": [
        "primary",
        "secondary",
        "danger",
        "neutral"
      ],
      "default": "primary"
    },
    "loading": {
      "type": "boolean",
      "required": false,
      "description": "로딩 상태",
      "default": false
    },
    "count": {
      "type": "number",
      "required": false,
      "description": "카운트 배지"
    },
    "thumbnail": {
      "type": "string",
      "required": false,
      "description": "내부 썸네일 이미지 URL"
    },
    "fullWidth": {
      "type": "boolean",
      "required": false,
      "description": "부모 너비 100%",
      "default": false
    },
    "fab": {
      "type": "boolean",
      "required": false,
      "description": "FAB — 화면 위 독립 노출 시 shadow 적용",
      "default": false
    }
  }
}
