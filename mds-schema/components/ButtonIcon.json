{
  "component": "ButtonIcon",
  "category": "Buttons",
  "description": "MDS ButtonIcon component",
  "platform": [
    "web",
    "app"
  ],
  "props": {
    "variant": {
      "type": "enum",
      "required": false,
      "description": "강조 수준 스타일",
      "values": [
        "plain",
        "outlined",
        "tonal",
        "solid"
      ],
      "default": "solid"
    },
    "size": {
      "type": "enum",
      "required": false,
      "description": "높이 기준 사이즈 (sm=36 · md=40 · lg=44 · xl=48 · 2xl=52)",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "2xl"
      ],
      "default": "md"
    },
    "color": {
      "type": "enum",
      "required": false,
      "description": "색상 테마",
      "values": [
        "primary",
        "secondary",
        "danger",
        "neutral"
      ],
      "default": "primary"
    },
    "shape": {
      "type": "enum",
      "required": false,
      "description": "버튼 형태 — square(사각) · round(원형)",
      "values": [
        "square",
        "round"
      ],
      "default": "square"
    },
    "loading": {
      "type": "boolean",
      "required": false,
      "description": "로딩 상태",
      "default": false
    },
    "fab": {
      "type": "boolean",
      "required": false,
      "description": "FAB — 화면 위 독립 노출 시 shadow 적용",
      "default": false
    }
  }
}
