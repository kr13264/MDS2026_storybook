{
  "component": "ReactionHorizontal",
  "category": "Reaction",
  "description": "MDS ReactionHorizontal component",
  "platform": [
    "web",
    "app"
  ],
  "props": {
    "type": {
      "type": "enum",
      "required": false,
      "description": "리액션 타입",
      "values": [
        "like",
        "comment",
        "share",
        "bookmark"
      ],
      "default": "like"
    },
    "size": {
      "type": "enum",
      "required": false,
      "description": "사이즈",
      "values": [
        "default",
        "small"
      ],
      "default": "default"
    },
    "selected": {
      "type": "boolean",
      "required": false,
      "description": "선택 상태",
      "default": false
    },
    "showCount": {
      "type": "boolean",
      "required": false,
      "description": "숫자 표시 여부",
      "default": true
    },
    "count": {
      "type": "number",
      "required": false,
      "description": "카운트 값",
      "default": 0
    }
  }
}
