{
  "component": "Thumbnail",
  "category": "Thumbnail",
  "description": "MDS Thumbnail component",
  "platform": [
    "web",
    "app"
  ],
  "props": {
    "type": {
      "type": "enum",
      "required": false,
      "description": "썸네일 타입",
      "values": [
        "image",
        "media",
        "gallery"
      ],
      "default": "image"
    },
    "radius": {
      "type": "enum",
      "required": false,
      "description": "모서리 반경",
      "values": [
        0,
        8,
        12,
        16,
        20
      ],
      "default": 0
    },
    "ratio": {
      "type": "enum",
      "required": false,
      "description": "이미지 비율 — 설정 시 width 기준으로 height 자동 계산",
      "values": [
        "1:1",
        "3:2",
        "3:4",
        "3:4.5",
        "3:5",
        "16:9"
      ]
    },
    "src": {
      "type": "string",
      "required": false,
      "description": "이미지 URL"
    },
    "alt": {
      "type": "string",
      "required": false,
      "description": "이미지 alt 텍스트",
      "default": ""
    },
    "width": {
      "type": "number",
      "required": false,
      "description": "너비 (px)",
      "default": 150
    },
    "height": {
      "type": "number",
      "required": false,
      "description": "높이 (px) — ratio 미설정 시 사용"
    },
    "duration": {
      "type": "string",
      "required": false,
      "description": "재생시간 텍스트 (media·gallery 타입) — 예: \"03:25\""
    },
    "badge": {
      "type": "string",
      "required": false,
      "description": "좌상단 코너 뱃지 텍스트 — 예: \"LIVE\", \"NEW\""
    },
    "rank": {
      "type": "number",
      "required": false,
      "description": "좌하단 랭킹 번호"
    },
    "showMore": {
      "type": "boolean",
      "required": false,
      "description": "우상단 더보기 버튼 표시 여부",
      "default": false
    }
  }
}
